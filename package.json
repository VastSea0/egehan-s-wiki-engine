{
  "name": "egehan-s-wiki-engine",
  "version": "1.0.0",
  "description": "Text-first, zero-bloat wiki and publication engine with three-color link resolution, metadata directives, and human-thought boundaries.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.mjs",
      "require": "./dist/parser.js"
    },
    "./scriptEngine": {
      "types": "./dist/scriptEngine.d.ts",
      "import": "./dist/scriptEngine.mjs",
      "require": "./dist/scriptEngine.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PHILOSOPHY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/parser.ts src/scriptEngine.ts src/types.ts src/core.ts --format cjs,esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "wiki",
    "plain-text",
    "markdown",
    "digital-twin",
    "knowledge-base",
    "static-site-generator"
  ],
  "author": "Egehan Kahraman <egehankahraman0@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.5.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
